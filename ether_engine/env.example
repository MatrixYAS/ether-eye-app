# Ether Eye — Live Paper-Arbitrage Detector (engine environment variables)
# Copy this file to .env and fill in values. No keys are committed.

# --- Rust engine (ether_engine) ---
# Solana RPC endpoint (Helius, QuickNode, Triton, or public).
# If unset or unreachable, the engine falls back to deterministic demo mode.
RPC_PROVIDER_URL=https://api.mainnet-beta.solana.com

# Jito tip handling for execution-stage bundles.
# 1 = include a Jito tip assumption in the cost model; 0 = plain priority fees.
JITO_ENABLED=0

# Scanner thresholds (also adjustable live from the dashboard Config panel).
MAX_QUOTE_AGE_MS=3000
MIN_NET_PROFIT_USD=0.5
SAFETY_BUFFER_BPS=30

# Engine HTTP port used by the Node backend's localhost proxy.
ENGINE_PORT=18787

# Deterministic demo markets instead of live RPC (1 = demo, 0 = live).
DEMO_MODE=0
